# Food Finder Environment Variables Template
# Copy this file to .env and adjust variables as needed.
# Note: Expo environment variables must start with EXPO_PUBLIC_ prefix to be exposed to the app.

# Application Environment (development, staging, production)
EXPO_PUBLIC_APP_ENV=development

# Base URL for API calls
EXPO_PUBLIC_API_URL=https://api.foodfinder.local

# Toggle between mockup server/local mock data and actual network calls
EXPO_PUBLIC_MOCK_DATA=true

# API Key or client tokens if any
EXPO_PUBLIC_API_KEY=your_dev_api_key_here
